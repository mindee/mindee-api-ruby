# lib/mindee/v2/client_options/base_annotation_parameters.rb

module Mindee
  module V2
    module ClientOptions
      class BaseAnnotationParameters
        attr_reader document_id: String

        def initialize: (String document_id) -> void

        def self.from_hash: (?params: Hash[String | Symbol, untyped]) -> BaseAnnotationParameters

        def self.load_from_hash: (?params: Hash[String | Symbol, untyped]) -> Hash[String | Symbol, untyped]

        def request_parameters: -> Hash[String, String]
      end
    end
  end
end
