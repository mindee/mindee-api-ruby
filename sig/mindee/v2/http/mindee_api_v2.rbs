# lib/mindee/v2/http/mindee_api_v2.rbs
module Mindee
  module V2
    module HTTP
      interface _ResponseFactory[T]
        def new: (Hash[String | Symbol, untyped]) -> T
      end

      interface _ProductClass[T]
        def slug: () -> String

        def response_type: () -> _ResponseFactory[T]

        def params_type: () -> singleton(ClientOptions::BaseProductParameters)
      end

      interface _SearchParameters[T]
        def slug: () -> String

        def response_class: () -> _ResponseFactory[T]

        def request_parameters: () -> Hash[Symbol, String | Array[String]]
      end

      class MindeeApiV2
        attr_reader settings: ApiV2Settings

        def initialize: (?api_key: String?) -> void

        def req_get_result_by_id: [T] (_ProductClass[T] product, String inference_id) -> T

        def req_post_product_enqueue: (
          Input::Source::LocalInputSource | Input::Source::URLInputSource,
          ClientOptions::BaseProductParameters
        ) -> V2::Parsing::JobResponse

        def req_get_job_by_id: (String job_id) -> V2::Parsing::JobResponse

        def req_get_job_by_url: (String url) -> V2::Parsing::JobResponse

        def req_get_result_by_url: [T] (_ProductClass[T] product, String url) -> T

        def process_response: (Net::HTTPResponse?) -> Hash[String | Symbol, untyped]

        def poll: (String) -> Net::HTTPResponse

        def enqueue: (
          Input::Source::LocalInputSource | Input::Source::URLInputSource,
          ClientOptions::BaseProductParameters
        ) -> Net::HTTPResponse?

        def req_get_search: [T] (_SearchParameters[T] params) -> T

        private

        def validate_https_url!: (String) -> void
      end
    end
  end
end
