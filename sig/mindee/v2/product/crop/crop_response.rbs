# lib/mindee/v2/product/crop/crop_response.rb

module Mindee
  module V2
    module Product
      module Crop
        class CropResponse < Parsing::BaseInferenceResponse[CropInference]
          self.@slug: String
          self.@_parameters_class: singleton(Params::CropParameters)

          attr_reader inference: CropInference
          def initialize: (Hash[String | Symbol, untyped]) -> void

          def _parameters_class: -> singleton(Params::CropParameters)

          def to_s: -> String
          def self._parameters_class: () -> singleton(Params::CropParameters)
          def self.slug: () -> String
        end
      end
    end
  end
end
