# lib/mindee/v2/product/extraction/extraction.rb

module Mindee
  module V2
    module Product
      module Extraction
        class Extraction < Product::BaseProduct
          def self.parameters_class: () -> singleton(Params::ExtractionParameters)
          def self.response_class: () -> singleton(ExtractionResponse)
          def self.annotation_response_class: () -> singleton(RagDocuments::ExtractionRagAnnotationResponse)
          def self.annotation_parameters_class: () -> singleton(RagDocuments::Params::RagDocumentAnnotationParameters)
          def self.rag_document_upload_class: () -> singleton(RagDocuments::Params::RagDocumentUploadParameters)
        end
      end
    end
  end
end
