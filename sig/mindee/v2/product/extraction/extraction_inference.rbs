module Mindee
  module V2
    module Product
      module Extraction
        class ExtractionInference
          attr_reader self.parameters_class: singleton(Params::ExtractionParameters)
          attr_reader self.slug: String

          attr_reader active_options: Parsing::InferenceActiveOptions
          attr_reader result: ExtractionResult

          def initialize: (Hash[String | Symbol, untyped]) -> void
          def to_s: -> String
        end
      end
    end
  end
end
