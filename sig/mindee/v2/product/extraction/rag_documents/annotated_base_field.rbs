# lib/mindee/v2/product/extraction/rag_documents/annotated_base_field.rb

module Mindee
  module V2
    module Product
      module Extraction
        module RagDocuments
          class AnnotatedBaseField
            attr_accessor selected: bool
            attr_accessor guidelines: String?

            def initialize: (?bool?, ?String?) -> void
            def to_h: () -> Hash[String, untyped]
            def to_json: (?untyped) -> String
            def self.create_annotated_field: (Hash[String | Symbol, untyped]) -> (AnnotatedListField | AnnotatedObjectField | AnnotatedSimpleField)
          end
        end
      end
    end
  end
end
