module Mindee
  module V2
    module Product
      class BaseProduct
        self.@slug: String
        self.@parameters_class: singleton(ClientOptions::BaseProductParameters)
        self.@response_class: singleton(Parsing::BaseInferenceResponse)
        self.@annotation_response_class: singleton(Parsing::BaseRagAnnotationResponse)
        self.@annotation_parameters_class: singleton(ClientOptions::BaseAnnotationParameters)
        self.@rag_document_upload_class: singleton(ClientOptions::BaseRagDocumentUploadParameters)

        def self._parameters_class: () -> singleton(ClientOptions::BaseProductParameters)

        attr_reader self.slug: String
        attr_reader self.parameters_class: singleton(ClientOptions::BaseProductParameters)
        attr_reader self.response_class: singleton(Parsing::BaseInferenceResponse)
        attr_reader self.annotation_response_class: singleton(Parsing::BaseRagAnnotationResponse)
        attr_reader self.annotation_parameters_class: singleton(ClientOptions::BaseAnnotationParameters)
        attr_reader self.rag_document_upload_class: singleton(ClientOptions::BaseRagDocumentUploadParameters)

        def initialize: -> void
      end
    end
  end
end
