root = true

# All files
[*]
indent_style = space
insert_final_newline = true
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true

# Config files
[*.{yml,yaml,toml}]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown files
[*.{md,markdown}]
trim_trailing_whitespace = false

[*.{rb,rake,gemspec,rbs,ru}]
indent_size = 2

[*.sh]
indent_size = 2

[Makefile]
indent_style = tab
